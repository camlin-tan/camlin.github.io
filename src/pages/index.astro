---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SystemGraphic from '../components/SystemGraphic.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects, experience, skillGroups } from '../data/portfolio';
---
<Layout>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#" aria-label="Camlin Tan, back to top"><span class="brand-mark">c<span>t</span><i></i></span><span>camlin<span class="brand-dot">.</span>tan</span></a>
      <nav id="main-nav" class="main-nav" aria-label="Main navigation">
        <a href="#experience">Experience</a><a href="#work">Projects</a><a href="#about">About</a><a href="#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle icon-button" aria-label="Switch to light theme" title="Switch theme"><Icon name="sun" class="sun-icon" size={18}/><Icon name="moon" class="moon-icon" size={18}/></button>
        <button class="menu-toggle icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" class="menu-icon"/><Icon name="close" class="close-icon"/></button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-heading">
      <div class="hero-main">
        <div class="hero-copy">
          <div class="eyebrow hero-eyebrow"><span class="status-dot"></span> SOFTWARE ENGINEER <span class="eyebrow-divider">/</span> SINGAPORE</div>
          <h1 id="hero-heading">Thoughtful code.<br/><span>Dependable systems.</span></h1>
          <p class="hero-intro">I’m <strong>Camlin Tan</strong>, a computer science student at NUS.<br class="desktop-break"/> I build dependable backends, AI infrastructure, and full-stack applications with care.</p>
          <div class="hero-actions"><a class="button button-primary" href="#experience">View my experience <Icon name="down" size={17}/></a></div>
          <p class="availability"><span class="status-dot"></span>{profile.availability}</p>
        </div>
        <SystemGraphic />
      </div>
      <div class="credentials">
        <div><span class="credential-label">RECENTLY AT</span><p><strong>HTX</strong><span>Backend & AI engineering</span></p></div>
        <div><span class="credential-label">STUDYING AT</span><p><strong>NUS</strong><span>B.Comp. Computer Science</span></p></div>
        <div><span class="credential-label">ACADEMIC FOUNDATION</span><p><strong>4.88<span class="gpa-denominator"> / 5.0</span></strong><span>Dean’s List ’24/25</span></p></div>
      </div>
    </section>

    <section id="experience" class="section container" aria-labelledby="experience-heading">
      <div class="section-heading"><div><div class="eyebrow section-eyebrow"><span>01</span> EXPERIENCE</div><h2 id="experience-heading">Built in good company<span class="accent">.</span></h2></div></div>
      <div class="timeline">{experience.map((job, index) => <article class:list={['experience-item', { 'experience-featured': index === 0 }]}>
        <div class="experience-date"><span class="timeline-point"></span><span class="mono">{job.period}</span><span class="experience-location">Singapore</span></div>
        <div class="experience-body"><div class="experience-title"><div><h3>{job.role}</h3><p class="company-name">{job.company}<span>{job.specialism && ` / ${job.specialism}`}</span></p></div>{index === 0 && <span class="company-monogram">ht<span>x</span></span>}</div><p class="experience-context">{job.fullName}</p><p class="experience-summary">{job.summary}</p>{job.highlights.length > 0 && <ul class="experience-highlights">{job.highlights.map(point => <li>{point}</li>)}</ul>}<ul class="tags">{job.tags.map(tag => <li>{tag}</li>)}</ul></div>
      </article>)}</div>
    </section>

    <section id="work" class="section container" aria-labelledby="work-heading">
      <div class="section-heading"><div><div class="eyebrow section-eyebrow"><span>02</span> SELECTED WORK</div><h2 id="work-heading">Ideas into working software<span class="accent">.</span></h2></div><span class="section-aside">A few things I’ve been building <Icon name="down" size={16}/></span></div>
      <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div>
      <p class="work-footnote"><Icon name="code" size={16}/><span>From collaborative interfaces to the systems behind them.</span><a href={profile.github} target="_blank" rel="noopener noreferrer">Find me on GitHub <Icon name="arrow" size={14}/><span class="sr-only"> (opens in a new tab)</span></a></p>
    </section>

    <section id="about" class="section container" aria-labelledby="about-heading">
      <div class="section-heading"><div><div class="eyebrow section-eyebrow"><span>03</span> A LITTLE ABOUT ME</div><h2 id="about-heading">Curiosity, with a solid foundation<span class="accent">.</span></h2></div></div>
      <div class="about-grid"><div class="about-copy"><p>I’m drawn to the engineering underneath a good product: how data moves, how services work together, and how systems recover when things don’t go to plan.</p><p>At HTX, that meant checkpointed AI workflows, sandboxed validation, live application previews, and safer generated-code edits. My projects span streaming market data, multimodal retrieval, computer vision, and collaborative tools.</p><p>Teaching has shaped how I work, too. Whether I’m explaining graph theory or reviewing a pull request, I value making complex ideas clear.</p><div class="about-location"><Icon name="pin" size={16}/><span>Based in Singapore</span><span class="location-separator">·</span><span>Open to SWE opportunities</span></div></div>
        <aside class="education-card" aria-label="Education"><div class="education-top"><span class="eyebrow">EDUCATION</span><span class="education-mark">NUS</span></div><h3>National University<br/>of Singapore</h3><p>Bachelor of Computing<br/>in Computer Science</p><span class="education-date mono">Aug 2024 — Dec 2027 (expected)</span><div class="education-achievements"><div><strong>4.88 <span>/ 5.0</span></strong><span>GPA</span></div><div><strong>Dean’s List</strong><span>AY 2024/25</span></div></div><p class="coursework">Data structures & algorithms · Software engineering · Operating systems · Object-oriented programming · AI & machine learning · Information security</p></aside>
      </div>
      <div class="toolbox"><div class="toolbox-heading"><span class="eyebrow">MY TOOLBOX</span><p>The right tools for the problem.</p></div><div class="skill-grid">{skillGroups.map(group => <div class="skill-group"><h3>{group.name}</h3><ul class="tags">{group.skills.map(skill => <li>{skill}</li>)}</ul></div>)}</div></div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-heading"><div class="container contact-inner"><div class="contact-top"><div class="eyebrow"><span>04</span> WHAT’S NEXT</div><span class="contact-availability"><span class="status-dot"></span> {profile.availability}</span></div><h2 id="contact-heading">Let’s build something<br/><span>worth building.</span></h2><div class="contact-bottom"><p>Have a role, a project, or an interesting problem?<br/>I’d love to hear about it.</p><div class="email-group"><a href={`mailto:${profile.email}`} class="email-link">{profile.email}<Icon name="arrow" size={24}/></a><button class="copy-email icon-button" data-email={profile.email} aria-label="Copy email address" title="Copy email address"><Icon name="copy" size={18}/></button><span class="copy-feedback sr-only" role="status" aria-live="polite"></span></div></div></div></section>
  </main>

  <footer class="container site-footer"><a class="footer-brand" href="#">Camlin Tan<span class="accent">.</span></a><span class="footer-note">Thoughtfully built. Always learning.</span><div class="footer-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={14}/><span class="sr-only"> (opens in a new tab)</span></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="arrow" size={14}/><span class="sr-only"> (opens in a new tab)</span></a><a href="#" class="back-top">Back to top <Icon name="arrow" size={14}/></a></div></footer>
</Layout>
